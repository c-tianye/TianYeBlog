---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import Note from "@/components/note/Note.astro";
import Pagination from "@/components/Paginator.astro";
import { type Lang, localizePath, useTranslations } from "@/i18n/ui";
import PageLayout from "@/layouts/Base.astro";
import type { NoteEntry } from "@/types";

interface Props {
	lang: Lang;
	page: Page<NoteEntry>;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);

const meta = {
	description: t("notes.description"),
	title: t("notes.title"),
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: t("notes.prev"),
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: t("notes.next"),
			url: page.url.next,
		},
	}),
};
---

<PageLayout meta={meta}>
	<section>
		<h1 class="title mb-12 flex items-center gap-3">
			{t("notes.title")}
			<a class="text-accent" href={localizePath("/notes/rss.xml", lang)} target="_blank">
				<span class="sr-only">{t("common.rssFeed")}</span>
				<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="mdi:rss" />
			</a>
		</h1>
		<ul class="mt-6 space-y-8 text-start">
			{page.data.map((note) => (
				<li class="">
					<Note note={note} as="h2" isPreview />
				</li>
			))}
		</ul>
		<Pagination {...paginationProps} />
	</section>
</PageLayout>
